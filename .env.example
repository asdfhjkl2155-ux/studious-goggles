# انسخ هذا الملف باسم .env واملأ القيم. لا ترفع ملف .env إلى GitHub.

# من @BotFather في تيليجرام
TELEGRAM_BOT_TOKEN=

# من https://fal.ai/dashboard/keys — اتركه فارغاً إذا كنت تستخدم الموديل المحلي فقط
FAL_KEY=

# رقم حسابك في تيليجرام (أرسل /id للبوت لتعرفه). أكثر من رقم: افصل بفاصلة.
ALLOWED_USER_IDS=

# اختياري: auto (اختيار تلقائي من fal) أو local (على الماك) أو veo أو wan أو kling أو معرّف endpoint من fal
DEFAULT_MODEL=auto

# اختياري، للموديل المحلي فقط:
# LOCAL_AUDIO=1                 توليد صوت مع الفيديو
# LOCAL_TIMEOUT_SECONDS=3600    أقصى وقت للمقطع الواحد
